<?xml version="1.0"?>
<robot name="balancebot_bigwheel">
<link name="base_link">
    <visual>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
            <!-- depth(X)=0.06  width(Y)=0.157  height(Z)=0.10 -->
            <box size="0.06 0.157 0.10"/>
        </geometry>
        <material name="blue">
            <color rgba="0.1 0.1 1.0 1.0"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <geometry>
           <box size="0.06 0.157 0.10"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <!--
        Inertia for box: depth(X)=0.06, width(Y)=0.157, height(Z)=0.10, mass=0.5kg
        ixx = m/12 * (Y² + Z²) = 0.5/12 * (0.157² + 0.10²) = 0.00144
        iyy = m/12 * (X² + Z²) = 0.5/12 * (0.06²  + 0.10²) = 0.00057
        izz = m/12 * (X² + Y²) = 0.5/12 * (0.06²  + 0.157²)= 0.00118
        -->
        <mass value="0.500"/>
        <inertia ixx="0.00144" ixy="0.0"
                 iyy="0.00057" iyz="0.0"
                 izz="0.00118"/>
    </inertial>
</link>

<!-- ═══════════════════════════════════════════════════════════
Battery Link 3s 1100mAh Li-ion
═══════════════════════════════════════════════════════════ -->
<link name="battery_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <!-- 62mm x 27mm x 25mm -->
            <box size="0.062 0.027 0.025"/>
        </geometry>
        <material name="red">
            <color rgba="1.0 0.0 0.0 1.0"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size="0.062 0.027 0.025"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <!--
        X = 0.062 m
        Y = 0.027 m
        Z = 0.025 m
        Mass = 0.073 kg

        Ixx = m/12 * (Y² + Z²) = 0.00000825
        Iyy = m/12 * (X² + Z²) = 0.00002725
        Izz = m/12 * (X² + Y²) = 0.00002788
        -->
        <mass value="0.073"/>
        <inertia ixx="0.00000825"
                 ixy="0.0"
                 ixz="0.0"
                 iyy="0.00002725"
                 iyz="0.0"
                 izz="0.00002788"/>
        </inertial>
</link>

<joint name="battery_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_link"/>
    <!-- centered in X/Y, near top of body -->
    <origin xyz="0 0 -0.0125" rpy="0 0 0"/>
</joint>

<!-- ═══════════════════════════════════════════════════════════
IMU Link (MPU6050)
Mounted at TOP of body frame, perfectly centred
Fixed joint — does not move relative to body
Mass included so CoM calculation is accurate
═══════════════════════════════════════════════════════════ -->

<link name="imu_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <!-- MPU6050 physical size: 20mm × 16mm × 1.5mm -->
            <box size ="0.02 0.016 0.0015"/>
        </geometry>
        <material name="green">
            <color rgba="0.0 0.8 0.2 1.0"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size ="0.02 0.016 0.0015"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <!-- MPU6050 weighs approximately 1g = 0.001kg -->
        <mass value="0.001"/>
        <inertia ixx="0.000001" ixy="0.0"
                 iyy="0.000001" iyz="0.0"
                 izz="0.000001"/>
    </inertial>
</link>

  <!-- Fixed joint — IMU rigidly attached at top of body, centred -->
<joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!--
      Top of body = 0.10m above axle, centred in X and Y
    -->
    <origin xyz="0 0 0.00075" rpy="0 0 0"/>
</joint>    

  <!-- ═══════════════════════════════════════════════════════════
       LEFT WHEEL
       y offset = -wheelbase/2 = -0.1015m from centre
  ═══════════════════════════════════════════════════════════ -->

<link name="left_wheel">
    <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
        <cylinder radius="0.065" length="0.028"/>
        </geometry>
        <material name="black">
            <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.028"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <mass value="0.100"/>
      <!--
        Inertia for cylinder: radius=0.065, length=0.028, mass=0.1kg
        ixx=iyy = m/12 * (3r² + l²) = 0.1/12 * (3×0.065² + 0.028²) = 0.000112158
        izz     = m/2  * r²         = 0.1/2  * 0.065²               = 0.00021125
      -->
      <inertia ixx="0.000112158" ixy="0.0" ixz="0.0"
               iyy="0.000112158" iyz="0.0"
               izz="0.00021125"/>
    </inertial>
</link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <!--
      y length = 0.15m + gap (2.3cm) + gap (2.3cm) = 0.203m
      y = -wheelbase/2 = -(0.203/2) = -0.1015m
      Wheelbase derivation: box_half(7.85cm) + gap(2.3cm) = 10.15cm
    -->
    <origin xyz="0 -0.1015 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>
  

    <!-- ═══════════════════════════════════════════════════════════
       RIGHT WHEEL
       y offset = +wheelbase/2 = +0.1015m from centre
  ═══════════════════════════════════════════════════════════ -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.028"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.028"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <mass value="0.100"/>
      <inertia ixx="0.000112158" ixy="0.0" ixz="0.0"
               iyy="0.000112158" iyz="0.0"
               izz="0.00021125"/>
    </inertial>
  </link>

    <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <!--
      y = +wheelbase/2 = +(0.203/2) = +0.1015m
    -->
    <origin xyz="0 0.1015 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

</robot>
